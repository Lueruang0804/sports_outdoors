FLASK_ENV=development
SECRET_KEY=change-this-secret-key
APP_BASE_URL=http://localhost:5000

# Supabase PostgreSQL connection string
# Format:
# postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Optional email settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
